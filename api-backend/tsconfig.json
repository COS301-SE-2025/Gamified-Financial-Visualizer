// /gamified-finance-api/tsconfig.json
{
   "extends": "../tsconfig.json",
   "compilerOptions": {
       "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
     "rootDir": ".", 
    // Removed "rootDir" to allow sources from multiple service folders
    "baseUrl": ".", 
   },
   "include": [
       "./*.ts", "./**/*.ts"
   ],
   // "exclude": [
   //     "node_modules",
   //     "dist"
   // ]
}